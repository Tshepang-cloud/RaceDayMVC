@model IEnumerable<RacedayMvc.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-primary fw-bold">Organiser Dashboard</h1>
    <a asp-controller="Events" asp-action="Create" class="btn btn-warning fw-bold">+ Create New Event</a>
</div>

<div class="alert alert-info">
    Welcome back, <strong>@Context.Session.GetString("UserName")</strong>!
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12"><p class="text-muted">You haven't created any events yet.</p></div>
    }
    else
    {
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@ev.Name</h5>
                        <p class="card-text text-muted">📍 @ev.Location <br> 📅 @ev.Date.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
            </div>
        }
    }
</div>
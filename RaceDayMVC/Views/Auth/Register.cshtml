@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-dark text-warning text-center py-3">
                <h3 class="mb-0 fw-bold">Join RaceDay</h3>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">I am a:</label>
                        <select name="role" class="form-select">
                            <option value="Participant">Participant (Runner)</option>
                            <option value="Organiser">Organiser</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">Create Account</button>
                </form>
                <div class="text-center mt-3">
                    <small>Already have an account? <a asp-action="Login">Login here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>
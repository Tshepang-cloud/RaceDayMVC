@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-dark text-warning text-center py-3">
                <h3 class="mb-0 fw-bold">🏃‍♂️ RaceDay Login</h3>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" name="email" class="form-control" required placeholder="runner@raceday.com" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Password</label>
                        <input type="password" name="password" class="form-control" required placeholder="••••••••" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2">Login</button>
                </form>
                <div class="text-center mt-3">
                    <small>Don't have an account? <a asp-action="Register">Register here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>